# Copy this file to settings.env and fill in YOUR tenant's values, then run ./generate-config.sh.
# settings.env is gitignored - your real tenant/journey details never get committed back here.

# --- Your real PingAM / Advanced Identity Cloud tenant ---
TARGET_SUB=openam-mzimny          # the subdomain of your tenant, e.g. "openam-mycompany"
TARGET_DOMAIN=forgeblocks.com     # the base domain of your tenant
REALM=alpha                       # the AM realm your journey/tree lives in
TREE_NAME=Demo-Protect-Latest     # the named tree (authIndexValue) with the Protect node

# --- The phishing side (where Evilginx serves the test page) ---
PHISHING_DOMAIN=phish.iamworld.co.uk   # a real, registered domain you own or control (see
                                        # README "Choosing a phishing domain" for why it must be
                                        # real, not a .local/fake TLD)
PHISH_SUB=                             # leave blank for the bare PHISHING_DOMAIN with no
                                        # subdomain prefix, or set a prefix (e.g. "login")
